%h2
  = "My TAPAS"
%hr

%div.row
  %div.col-sm-6
    %panel.panel-default.panel-projects
      %div.panel-heading
        %h2.panel-title
          = "Projects"
      %div.panel-body
        %a{href:new_project_path, class: 'btn btn-success btn-sm'}
          %i.fa.fa-plus
          = "Add New"
          %br
          %br
        %table.table
          - if @projects.empty?
            = "There are no projects yet."
          - else
            - @projects.each do |p|
              %tr
                %td
                  %h4
                    = link_to(p['title_info_title_ssi'], project_path(p['id']))
                %td
                  - if @user.can? :manage, p
                    %a{href:edit_project_path(p['id']), class: ['btn','btn-xs','btn-default']}
                      %i.fa.fa-pencil
                      = "Edit"
        %a{href:my_projects_path, class: ['btn','btn-default']}
          = "View All"
    %br
    %panel.panel-default.panel-collections
      %div.panel-heading
        %h2.panel-title
          = "Collections"
      %div.panel-body
        - if @user && !@projects&.empty?
          %a{href:new_collection_path, class: 'btn btn-success btn-sm'}
            %i.fa.fa-plus
            = "Add New"
          %br
        %table.table
          - if @collections.empty?
            = "You have no collections yet."
          - else
            - @collections.each do |c|
              %tr
                %td
                  %h4
                    = link_to(c['title_info_title_ssi'], collection_path(c['id']))
                %td
                  - if @user.can? :manage, c
                    %a{href:edit_collection_path(c['id']), class: ['btn','btn-xs','btn-default']}
                      %i.fa.fa-pencil
                      = "Edit"
        %a{href:my_collections_path, class: ['btn','btn-default']}
          = "View All"
  %div.col-sm-6
    %panel.panel-default.panel-records
      %div.panel-heading
        %h2.panel-title
          = "Records"
      %div.panel-body
        - if @user && !@collections.empty?
          %a{href:new_core_file_path, class: 'btn btn-success btn-sm'}
            %i.fa.fa-plus
            = "Add New"
          %br
        %table.table
          - if !@records.empty?
            = "There are no collections yet."
          - else
            - @records.each do |r|
              %tr
                %td
                  %h4
                    = link_to(r['title_info_title_ssi'], core_file_path(r['id']))
                %td
                  - if @user.can? :manage, r
                    %a{href:edit_core_file_path(r['id']), class: ['btn','btn-xs','btn-default']}
                      %i.fa.fa-pencil
                      = "Edit"
        %a{href:my_records_path, class: ['btn','btn-default']}
          = "View All"
