= form_for @project do |f|
  .container-fluid
    .row
      .form-horizontal
        .form-group
          = f.label :title, "Title", class: "control-label col-md-2"
          .col-md-6
            = f.text_field :title, required: true, pattern: ".*\\S.*", name: 'project[title]', class: "form-control", placeholder: "University Libraries"
        .form-group
          = f.label :description, "Description", class: "control-label col-md-2"
          .col-md-6
            = f.text_area :description, required: true, pattern: ".*\\S.*", name: 'project[description]', class: "form-control", placeholder: "Brief description of the project"
            %p.small.help-block="This field accepts plain text"
        .form-group
          = f.label :is_public, "Public?", class: "control-label col-md-2"
          = f.check_box :is_public, { checked: true }
        .form-group
          = f.label :image_file, "Thumbnail", class: "control-label col-md-2"
          .col-md-6
            - if @project.image_file.attached?
              =image_tag url_for(@project.image_file)
              = f.label :remove_image_file, "Remove Thumbnail"
              = f.check_box "remove_image_file", {:checked => false}
            = f.file_field :image_file, accept: ".jpeg, .jpg, .png", direct_upload: true


    -#.row.form-group.institutions
    -#  = f.label :institutions, "Affiliated Institutions", class: "control-label col-md-2"
    -#  .col-md-6
    -#    %span.institution
    -#      = f.select :institutions, options_for_select(@institutions, @project.institutions.pluck(:id)), {}, {name: "community[institutions][]", class: "form-control pb1", multiple: true}

      -# TODO - add content date
      -# TODO - add keywords/subjects
    .row.form-group.project_members
      = f.label :project_members,"Project Members", class: "control-label col-md-2"
      .col-md-6
        %span.project_member
          = f.select :project_members, options_for_select(@project.members.values), {}, {name: "project[members][]", class: "form-control", multiple: true}

    -#.row.form-group.project_editors
    -#  = f.label :project_editors, "Project Editors", class: "control-label col-md-2"
    -#  .col-md-6
    -#    %span.project_editor
    -#      = f.select :project_editors, options_for_select(@users, @project.members['editors']), {}, { name: 'project.members[editors][]', class: "form-control", multiple: true}

    .row.form-group.project_admins
      = f.label :admins, "Project Admins", class: "control-label col-md-2"
      .col-md-6
        %span.project_admin
          = f.select :admins, options_for_select(@project.members.values), {}, { name: 'project_admins', class: "form-control", multiple: true}

  -# .row
  -#   .col-md-2
  -#     = f.label :og_reference, "External links"
  -#   .col-md-6
  -#     = f.text_area :og_reference, name: 'community[og_reference][]', class: "form-control", rows: 5
  -#     -# TODO

  %hr
  .form-actions
    = f.submit class: ['btn', 'btn-primary', 'btn-large'], value: 'Submit'
