%div.navbar-right
  .nav.navbar-nav
  - if current_user.nil?
    %a.btn.btn-primary.btn-sm.app-header-nav-buttons{href: new_user_registration_path, type: 'button'}= t('nav.sign_up')
    %a.btn.btn-primary.btn-sm.app-header-nav-buttons{href: new_user_session_path, type: 'nav'}= t("nav.log_in")
  - elsif current_user
    %a.btn.btn-primary.btn-sm.app-header-nav-buttons{href: my_tapas_path, type: 'nav'} My Tapas
    %a.btn.btn-primary.btn-sm.app-header-nav-buttons{href: edit_user_registration_path, type: 'nav'}= current_user.name
    %a.btn.btn-primary.btn-sm.app-header-nav-buttons{href: destroy_user_session_path, type: 'nav'}= t('blacklight.header_links.logout')
    - if current_user.admin?
      %a.btn.btn-primary.btn-sm.app-header-nav-buttons{href: admin_path, type: 'nav'} Admin
