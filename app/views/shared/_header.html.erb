    <!-- TAPAS site navigation -->
    <nav id="header-nav" class="collapse navbar-collapse" aria-label="Site">
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <button type="button" class="nav-link dropdown-toggle" aria-expanded="false" 
            data-bs-toggle="dropdown">About</button>
          <ul class="dropdown-menu">
            <li class="nav-item"><!-- New landing page -->
              <a href="/about-tapas" class="dropdown-item">About TAPAS</a></li>
            <li class="nav-item">
              <a href="/mission" class="dropdown-item">Mission and History</a></li>
            <li class="nav-item">
              <a href="/tapas-team" class="dropdown-item">TAPAS Team</a></li>
            <li class="nav-item">
              <a href="/partners-and-supporters" 
                class="dropdown-item">Partners and Supporters</a></li>
            <li class="nav-item">
              <a href="/news" class="dropdown-item">News</a></li>
            <li class="nav-item">
              <a href="/contact" class="dropdown-item">Contact Us</a></li>
          </ul>
        </li>
        <li class="nav-item dropdown">
          <button type="button" class="nav-link dropdown-toggle" aria-expanded="false" 
            data-bs-toggle="dropdown">Support</button>
          <ul class="dropdown-menu">
            <li class="nav-item">
              <a href="/getting-started-with-tapas" class="dropdown-item" 
