            <li>
              <a href="/classroom" class="dropdown-item">Teaching with TAPAS</a></li>
            <li>
              <a href="/tapas-commons/tei-templates" class="dropdown-item" 
                title="Learn the TEI with annotated TEI templates">TEI Templates</a></li>
            <li class="nav-item">
              <a href="/faq" class="dropdown-item">Frequently Asked Questions</a></li>
          </ul>
        </li>
        <li class="nav-item dropdown">
          <button type="button" class="nav-link dropdown-toggle" aria-expanded="false" 
