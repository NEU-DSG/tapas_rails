            <ul class="dropdown-menu">
              <li class="nav-item">
                <a href="/add/record" class="dropdown-item">TEI Record</a></li>
              <li class="nav-item">
                <a href="/add/collection" class="dropdown-item">Collection</a></li>
              <li class="nav-item">
                <a href="/add/project" class="dropdown-item">Project</a></li>
            </ul>
          </li>
        <% end %>
      </ul>
