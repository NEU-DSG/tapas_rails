<!--
    Header navbar
  -->
<header id="header" role="banner" class="navbar navbar-expand-md">
  <div class="container-fluid">
    <!-- TAPAS brand -->
    <a class="logo" href="/">
      <%= image_tag "logo_no_text.png", "alt": "" %>
      <span class="navbar-brand">TAPAS Project</span>
    </a>
