- parent = @collection.project || nil

%ul.breadcrumb
  %li
    = link_to parent.title, project_path(parent)
  %li
    = @collection.title

- if current_user_can? :manage, @collection
  = link_to "Edit", edit_collection_path(@collection), class: %w[btn btn-info btn-large]
  = link_to "Delete", collection_path(@collection), class: %w[btn btn-danger btn-large], method: "delete", confirm: "Are you sure you want to delete this collection?"

%h2.page-header= @collection.title

- records = @collection.core_files || []

%div.row
  %div.col-md-3
    %dt= "Project"
    %dd= link_to parent.title, parent
    - if @collection.image_file.nil?
      = image_tag "tapaslogo-opaque.png"
    -else
      = image_tag url_for(@collection.image_file)
    - if !@collection.description.blank?
      %dt= "Description"
      %dd= @collection.description
    %dt= "Record Count"
    %dd= records.count
  %div.col-md-9
    %panel.panel-default.panel-records
      %div.panel-heading
        %h3.panel-title
          = "Records"
        - if current_user_can? :manage, @collection
          %small
            %a{href:new_core_file_path, class: 'pull-right'}
              %i.fa.fa-plus
              = "Add New"
      %div.panel-body
        - unless records.empty?
          - records.each do |record|
            %div.col-lg-3
              .record.tile
                - if current_user_can? :manage, record
                  %a{href:edit_core_file_path(record), class: ['btn','btn-xs','btn-default','pull-right']}
                    %i.fa.fa-pencil
                      = "Edit"
                - if !record.image_file.attached?
                  = image_tag "tapaslogo-opaque.png"
                -else
                  -# - TODO: add logic to resize thumbnail image
                  = image_tag url_for(record.image_file)
                  %h4= link_to record.title, record
                - if record.file_type != :tei_content
                  %span.btn-xs.btn.btn-info= "Support File"
